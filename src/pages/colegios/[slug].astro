---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { site, schools, activities } from '../../data/site.js';
export function getStaticPaths() { return schools.map(s => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const acts = s.activities.map(k => activities[k]);
const names = acts.map(a => a.name).join(' y ');
const ld = [{ '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem', position:1, name:'Inicio', item:'https://negopolis.com/' },
  { '@type':'ListItem', position:2, name:'Colegios', item:'https://negopolis.com/colegios/' },
  { '@type':'ListItem', position:3, name:s.name, item:`https://negopolis.com/colegios/${s.slug}/` } ] }];
---
<Base title={`Extraescolar en ${s.name} (${s.town})`} description={`Extraescolar de ${names} en el ${s.name} de ${s.town}. Niños de 6 a 12 años, ${site.schedule}. Inscripción online curso ${site.course}.`} jsonld={ld}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs"><a href="/">Inicio</a> › <a href="/colegios/">Colegios</a> › {s.name}</nav>
      <h1>Extraescolares en {s.name}, {s.town}</h1>
      <p class="lead">Curso {site.course} · {site.ages} · {site.schedule}, en el propio colegio.</p>
      <a class="btn" href={`/inscripcion/?colegio=${s.slug}`}>Inscribirme en este colegio</a>
    </div>
  </section>
  <section><div class="wrap cards">
    {acts.map(a => (
      <article class={`card ${a.color}`}>
        <h2 style="font-size:1.5rem">{a.name}</h2>
        <p>{a.summary}</p>
        <ul>{a.points.map(([i, t]) => <li>{t}</li>)}</ul>
        <div class="actions">
          <a class="btn" href={`/inscripcion/?colegio=${s.slug}&actividad=${a.slug}`}>Inscribirme</a>
          <a class="btn btn-ghost" href={`/extraescolares/${a.slug}/`}>Ver actividad</a>
        </div>
      </article>
    ))}
  </div></section>
  <Cta href={`/inscripcion/?colegio=${s.slug}`} />
</Base>
